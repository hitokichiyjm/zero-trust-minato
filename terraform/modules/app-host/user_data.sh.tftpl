#!/bin/bash
# 社内アプリのサーバーの初期設定(起動時に1回だけ動く)
# IPv4 のインターネットへの経路はないため、AWS の API はデュアルスタック(IPv6)のエンドポイントを使う
set -euxo pipefail
export AWS_USE_DUALSTACK_ENDPOINT=true
export AWS_DEFAULT_REGION=${region}

# ---- 動作確認用の社内アプリ(127.0.0.1 だけで待ち受ける。外からは直接届かない) ----
%{ for name, app in apps ~}
mkdir -p /opt/apps/${name}
cat > /opt/apps/${name}/index.html <<'HTML'
<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><title>${app.title}</title></head>
<body style="font-family:sans-serif;margin:3rem">
<h1>${app.title}</h1>
<p>架空の会社「ミナト企画」の社内アプリ(動作確認用)です。</p>
<p>この画面は、Cloudflare Access で本人確認を通った人だけが見られます。サーバーには受信のポートが1つもありません。</p>
</body></html>
HTML
cat > /etc/systemd/system/app-${name}.service <<UNIT
[Unit]
Description=Demo app ${name}
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -m http.server ${app.port} --bind 127.0.0.1 --directory /opt/apps/${name}
DynamicUser=yes
Restart=always

[Install]
WantedBy=multi-user.target
UNIT
%{ endfor ~}

# ---- cloudflared(Cloudflare のパッケージから入れる。GitHub は IPv6 で届かないため) ----
curl -fsSL https://pkg.cloudflare.com/cloudflared-ascii.repo -o /etc/yum.repos.d/cloudflared.repo
for i in 1 2 3 4 5; do dnf install -y cloudflared && break || sleep 15; done

# トンネルのトークンを SSM から読み、root だけが読めるファイルに置く(コマンドラインには出さない)
install -d -m 700 /etc/cloudflared
for i in $(seq 1 20); do
  TOKEN=$(aws ssm get-parameter --name '${param_name}' --with-decryption --query Parameter.Value --output text) && break
  sleep 15
done
umask 077
printf 'TUNNEL_TOKEN=%s\n' "$TOKEN" > /etc/cloudflared/token.env
unset TOKEN

cat > /etc/systemd/system/cloudflared.service <<'UNIT'
[Unit]
Description=Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/cloudflared/token.env
# IPv4 のインターネットへの経路がないため、Cloudflare には IPv6 でつなぐ
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --edge-ip-version 6 run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
%{ for name, app in apps ~}
systemctl enable --now app-${name}.service
%{ endfor ~}
systemctl enable --now cloudflared.service
